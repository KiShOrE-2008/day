# ====================================================================
# SUPABASE ENVIRONMENT CONFIGURATION FOR SOWMIYAA BIRTHDAY WEBSITE
# ====================================================================
#
# 1. Go to https://supabase.com and open your project settings
# 2. Go to API -> Project URL & Project API Keys (anon / public)
# 3. Paste them below and save as `.env` in your project root folder

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key-here
